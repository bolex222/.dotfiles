{
    "layer": "top",
    "position": "top",
    "width": 1910,
    "height": 25,
    "margin": "5 0",

    "group/left" :  {
        "orientation": "horizontal",
        "modules":[
            "hyprland/workspaces",
            "hyprland/mode",
            "hyprland/scratchpad"
        ]
    },

    "group/right" : {
        "orientation": "horizontal",
        "modules" : [
            "hyprland/language",
            // "bluetooth",
            "group/group-volume",
            // "pulseaudio",
            "network",
            "tray ",
            // "battery",
            "cpu",
            "load",
            "memory",
            "temperature"
        ]
    },


    "modules-left"   : ["group/left"],
    "modules-center" : ["clock"],
    "modules-right"  : [ "group/right"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}
